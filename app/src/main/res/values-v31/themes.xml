<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OrigamiPDF" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_window_maroon</item>
        <item name="android:colorBackground">@color/maroon_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Seamless #440E03 OS starting window with zero icon flash -->
        <item name="android:windowSplashScreenBackground">@color/maroon_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
